// SBB, Serbia. The broker lists SBB only under this identifier.

// Identifier from the broker's v2/brands.
EON_BRAND = sbb-qa
// Language the platform names categories in when the Apple TV is set to it (otherwise English).
EON_LANGUAGE = sr
// Code sign-in needs a Smart TV client issued for this brand; only Vivacom's is known.
EON_CODE_SIGN_IN = NO
